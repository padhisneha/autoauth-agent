# AutoAuth Agent Environment Variables
# Copy this file to .env and fill in your values

# ─── Required ────────────────────────────────────────────────
# OpenAI API Key — used for all three AI agents
OPENAI_API_KEY=sk-your-openai-key-here

# LLM model — gpt-4.5-mini for speed + cost efficiency
OPENAI_MODEL=gpt-4.5-mini

# ─── Optional ────────────────────────────────────────────────
# Anthropic (not used by default, kept for future use)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database (defaults to SQLite for demo)
# DATABASE_URL=postgresql://user:password@localhost:5432/autoauth

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379

# Pinecone (optional, for vector store)
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=us-east-1

# FHIR Server (optional, mock is used in demo mode)
# FHIR_SERVER_URL=http://localhost:3001/fhir

# App Settings
APP_NAME=AutoAuth Agent
ENVIRONMENT=development
DEMO_MODE=true
MOCK_RESPONSES=true

# Change this in production
SECRET_KEY=development-secret-key-change-in-production
